{
  "name": "fake-star-check",
  "version": "0.1.0",
  "description": "Look for signs of fake GitHub stars and show the evidence: new and empty stargazer accounts, accounts starring in lockstep, star bursts, stars that disappeared, forks per star vs similar repos. CLI, GitHub Action and MCP server. Read-only, heuristic.",
  "type": "module",
  "bin": {
    "fake-star-check": "bin/fake-star-check.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
