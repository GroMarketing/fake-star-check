    "src",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "github",
    "github stars",
    "fake stars",
    "stargazers",
    "star history",
    "supply chain",
    "dependency vetting",
